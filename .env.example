# --- Required ---

# GoHighLevel Private Integration token.
# Settings -> Private Integrations -> create one with the scopes you need.
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default Location / sub-account id. Settings -> Business Profile, or read it
# out of the dashboard URL (.../location/<LOCATION_ID>/...). Optional only if
# every tool call passes locationId explicitly.
GHL_LOCATION_ID=

# --- Optional ---

# User id used as the sender when sending invoices and estimates. If unset the
# server falls back to the first user on the location. Find one with
# ghl_list_users.
# GHL_USER_ID=

# Invoice/estimate business block. GoHighLevel requires a business name and
# phone on every invoice; the server resolves them in this order:
#   per-call argument -> these variables -> saved invoice settings -> location
#   profile. Set these only to override what is already saved in GoHighLevel.
# GHL_BUSINESS_NAME=
# GHL_BUSINESS_PHONE=
# GHL_BUSINESS_ADDRESS=
# GHL_BUSINESS_WEBSITE=
# GHL_BUSINESS_LOGO_URL=

# Comma-separated module names to NOT register, trimming the tool surface.
# Names: contacts, opportunities, calendars, conversations, invoices, workflows,
# customFields, tasks, notes, products, estimates, payments, forms, users,
# funnels, calendarEvents, social, media, campaigns, tags, customValues,
# businesses, objects, associations
# GHL_DISABLED_MODULES=social,objects,associations,funnels

# API overrides. Defaults shown.
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
